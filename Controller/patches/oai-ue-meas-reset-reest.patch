+/* e2e-ts patch (oai-ue-meas-reset-reest.patch): measurement actions upon handover and re-establishment
+ * (TS 38.331 5.5.6.1), used by both. Before, only the handover cleared the neighbour entries; after a
+ * re-establishment to another cell, the entry of the new serving PCI stayed (the PHY does not measure the
+ * serving PCI, so no INT_MAX came to remove it) and every MeasurementReport carried it as a neighbour.
+ * - clear the L3 neighbour entries (filter state)
+ * - for each measId: stop the time-to-trigger timers (TA2, TA3) and reset reports_sent
+ * - event-triggered measIds: also stop the periodic_report_timer (it repeats the event report)
+ * - periodical measIds (trigger_quantity 0): keep the periodic_report_timer running. OAI starts it only
+ *   from the measConfig (start_periodical_report()), so stopping it here would end periodic reporting;
+ *   reports_sent = 0 makes the UE send one report as soon as the new serving cell is measured (5.5.4.1). */
+static void nr_rrc_meas_actions_upon_ho_reest(rrcPerNB_t *rrcNB)
+{
+  l3_measurements_t *l3m = &rrcNB->l3_measurements;
+  for (int i = 0; i < NUMBER_OF_NEIGHBORING_CELLS_MAX; i++) {
+    nr_ue_meas_reset(&l3m->neighboring_cell[i], false);
+    nr_ue_meas_reset(&l3m->neighboring_cell[i], true);
+  }
+  for (int j = 0; j < NR_MAX_MEAS_ID; j++) {
+    meas_report_params_t *p = &l3m->meas_report[j];
+    nr_timer_stop(&p->TA2);
+    nr_timer_stop(&p->TA3);
+    if (p->trigger_quantity > 0)
+      nr_timer_stop(&p->periodic_report_timer);
+    p->reports_sent = 0;
+  }
+}
+
+/* e2e-ts patch (oai-ue-meas-reset-reest.patch): true if this neighbour entry holds a value and is the serving
+ * cell. Entries without a value are ignored: unused entries keep Nid_cell 0 and cleared entries keep their
+ * old PCI (nr_ue_meas_reset() clears only the init flags), so they would match the serving PCI by chance.
+ * meas_t holds only the PCI, no SSB frequency, so this check is intra-frequency only: with inter-frequency
+ * neighbours it would also drop a cell with the serving PCI on another SSB frequency. */
+static bool is_serving_cell_entry(const l3_measurements_t *l3m, const meas_t *cell)
+{
+  const meas_t *s = &l3m->serving_cell;
+  const bool cell_has_value = cell->ss_rsrp_dBm.init || cell->csi_rsrp_dBm.init;
+  const bool serving_has_value = s->ss_rsrp_dBm.init || s->csi_rsrp_dBm.init;
+  return cell_has_value && serving_has_value && cell->Nid_cell == s->Nid_cell;
+}
