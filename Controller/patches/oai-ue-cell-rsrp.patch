+/* e2e-ts patch (oai-ue-cell-rsrp.patch): SS-RSRP of ONE cell, TS 38.215 clause 5.1.1:
+ * power of the resource elements that carry the SSS of that cell.
+ * nr_ue_calculate_ssb_rsrp() above sums the power of ALL SSS resource elements. When two
+ * cells send their SSB at the same time on the same subcarriers (synchronous TDD network,
+ * same SSB position), that sum is the power of both cells: the weaker neighbour is then
+ * reported as strong as the serving cell.
+ * Method: z[n] = rx[n] * d[n] (d = SSS sequence of the cell, TS 38.211 7.4.2.3).
+ * RSRP = |mean(z[n-1] * conj(z[n]))|. The product of neighbouring subcarriers removes the
+ * phase ramp of a timing offset. Noise of the two subcarriers is independent, so it gives no
+ * bias. Another cell's SSS uses a different sequence and is suppressed.
+ * Same unit as nr_ue_calculate_ssb_rsrp() (digital power per RE). Never returns 0. */
+static void nr_sss_sequence(int Nid_cell, int16_t d[LENGTH_SSS_NR])
+{
+  int16_t x0[LENGTH_SSS_NR] = {1, 0, 0, 0, 0, 0, 0};
+  int16_t x1[LENGTH_SSS_NR] = {1, 0, 0, 0, 0, 0, 0};
+  for (int i = 0; i < LENGTH_SSS_NR - 7; i++) {
+    x0[i + 7] = (x0[i + 4] + x0[i]) % 2;
+    x1[i + 7] = (x1[i + 1] + x1[i]) % 2;
+  }
+  const int nid2 = Nid_cell % 3;
+  const int nid1 = Nid_cell / 3;
+  const int m0 = 15 * (nid1 / 112) + 5 * nid2;
+  const int m1 = nid1 % 112;
+  for (int n = 0; n < LENGTH_SSS_NR; n++)
+    d[n] = (1 - 2 * x0[(n + m0) % LENGTH_SSS_NR]) * (1 - 2 * x1[(n + m1) % LENGTH_SSS_NR]);
+}
+
+static uint32_t nr_ue_calculate_ssb_rsrp_cell(const NR_DL_FRAME_PARMS *fp,
+                                              const c16_t rxdataF[][fp->ofdm_symbol_size],
+                                              int ssb_start_subcarrier,
+                                              int Nid_cell)
+{
+  int16_t d[LENGTH_SSS_NR];
+  nr_sss_sequence(Nid_cell, d);
+
+  double rsrp = 0;
+  for (int aarx = 0; aarx < fp->nb_antennas_rx; aarx++) {
+    const c16_t *rxF_sss = rxdataF[aarx] + ssb_start_subcarrier + 56; // SSS: subcarriers 56..182 of the SSB
+    double sum_r = 0, sum_i = 0;
+    double prev_r = (double)rxF_sss[0].r * d[0], prev_i = (double)rxF_sss[0].i * d[0];
+    for (int n = 1; n < LENGTH_SSS_NR; n++) {
+      const double z_r = (double)rxF_sss[n].r * d[n], z_i = (double)rxF_sss[n].i * d[n];
+      sum_r += prev_r * z_r + prev_i * z_i; // z[n-1] * conj(z[n])
+      sum_i += prev_i * z_r - prev_r * z_i;
+      prev_r = z_r;
+      prev_i = z_i;
+    }
+    rsrp += sqrt(sum_r * sum_r + sum_i * sum_i) / (LENGTH_SSS_NR - 1);
+  }
+  rsrp /= fp->nb_antennas_rx;
+  LOG_D(PHY, "cell RSRP/nb_re PCI %d: %.0f\n", Nid_cell, rsrp);
+  return rsrp < 1.0 ? 1 : (rsrp > (double)UINT32_MAX ? UINT32_MAX : (uint32_t)rsrp);
+}
