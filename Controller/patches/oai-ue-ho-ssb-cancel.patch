+/* e2e-ts patch (oai-ue-ho-ssb-cancel.patch): remove the SSB of the serving cell before the PBCH decode
+ * of the target cell in a handover sync. Use case: both cells use the same frequency and send their
+ * SSB at the same time (synchronous TDD). Design: thesis project doc ue-ssb-cancel-design.md. */
+#ifndef NR_UE_SSB_CANCEL_H
+#define NR_UE_SSB_CANCEL_H
+
+#include <stdbool.h>
+#include "PHY/defs_nr_UE.h"
+#include "PHY/NR_REFSIG/ss_pbch_nr.h" // NR_N_SYMBOLS_SSB
+
+/* Result of one cancellation, for the log line */
+typedef struct {
+  bool serving_decoded; // the PBCH of the serving cell passed the CRC check
+  double explained; // part of the received power on PBCH symbols 1 and 3 that the rebuilt serving SSB explains (0..1)
+  double removed_dB; // power on PBCH symbols 1..3 before / after the subtraction, in dB
+} nr_ssb_cancel_result_t;
+
+/* Decode the serving PBCH in the SSB symbols in[], rebuild the serving SSB (PSS, SSS, PBCH DM-RS, PBCH),
+ * estimate its channel and subtract it. Write the result to out[].
+ * Return false if the serving PBCH does not decode or the rebuilt SSB does not explain the received
+ * signal. Then do not use out[]. */
+bool nr_ue_ssb_cancel_serving(const UE_nr_rxtx_proc_t *proc,
+                              const NR_DL_FRAME_PARMS *fp,
+                              int serving_pci,
+                              int ssb_start_sc,
+                              const c16_t in[NR_N_SYMBOLS_SSB][fp->nb_antennas_rx][fp->ofdm_symbol_size],
+                              c16_t out[NR_N_SYMBOLS_SSB][fp->nb_antennas_rx][fp->ofdm_symbol_size],
+                              nr_ssb_cancel_result_t *res);
+
+/* Context of nr_ue_ssb_cancel_hook() */
+typedef struct {
+  const UE_nr_rxtx_proc_t *proc;
+  const NR_DL_FRAME_PARMS *fp;
+  int serving_pci;
+  int ssb_start_sc;
+  bool tried; // the hook ran
+  bool used; // the serving SSB was removed from rxdataF
+  nr_ssb_cancel_result_t res;
+} nr_ssb_cancel_ctx_t;
+
+/* Hook for nr_ssb_search_params_t.pre_sss: remove the serving SSB from rxdataF in place, before the SSS detection.
+ * rxdataF: c16_t [NR_N_SYMBOLS_SSB][fp->nb_antennas_rx][fp->ofdm_symbol_size]. ctx: nr_ssb_cancel_ctx_t. */
+void nr_ue_ssb_cancel_hook(void *ctx, void *rxdataF);
+#endif
