diff --git a/common/utils/nr/nr_common.c b/common/utils/nr/nr_common.c
index d117eea..cd7fa01 100644
--- a/common/utils/nr/nr_common.c
+++ b/common/utils/nr/nr_common.c
@@ -98,6 +98,18 @@ uint8_t get_rsrp_index(int rsrp_dBm)
   return (uint8_t)index;
 }
 
+/* e2e-ts patch (oai-ue-rrc-rsrp-report.patch): get_rsrp_index() caps at -44 dBm (16..113, the L1-RSRP range).
+ * For L3 reports that cap is too low: a serving cell at -42 dBm is reported as -44 dBm, and the gap to a
+ * neighbour is too small. Compare before the addition, so that INT_MAX (no measurement) cannot overflow. */
+uint8_t get_rsrp_index_l3(int rsrp_dBm)
+{
+  if (rsrp_dBm <= -157)
+    return 0;
+  if (rsrp_dBm >= 127 - 157)
+    return 127;
+  return (uint8_t)(rsrp_dBm + 157);
+}
+
