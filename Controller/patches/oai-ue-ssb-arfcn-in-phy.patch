+/* e2e-ts patch (oai-ue-ssb-arfcn-in-phy.patch): SSB ARFCN of the serving cell.
+ * Moved here from SCHED_NR_UE/phy_procedures_nr_ue.c. This file is in the library PHY_NR_UE
+ * and calls the function in is_neighboring_cell_due(). The PHY simulators (for example
+ * nr_pbchsim) link PHY_NR_UE, but not SCHED_NR_UE_LIB. */
+uint32_t get_ssb_arfcn(const NR_DL_FRAME_PARMS *frame_parms)
+{
+  uint32_t band_size_hz = frame_parms->N_RB_DL * 12 * frame_parms->subcarrier_spacing;
+  int ssb_center_sc = frame_parms->ssb_start_subcarrier + 120; // ssb is 20 PRBs -> 240 sub-carriers
+  uint64_t ssb_freq = frame_parms->dl_CarrierFreq - (band_size_hz / 2) + frame_parms->subcarrier_spacing * ssb_center_sc;
+  return to_nrarfcn(ssb_freq);
+}
