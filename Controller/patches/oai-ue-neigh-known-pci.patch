+/* Check known_pci at the serving SSB timing pss_pos (-1: this slot has no serving SSB), threshold factor.
+ * On success, rxdataF holds the SSB at pss_pos. Does not change the state of the cell. */
+static bool check_known_pci_at_serving_timing(const NR_DL_FRAME_PARMS *frame_parms,
+                                              uint16_t known_pci,
+                                              int pss_pos,
+                                              const known_pci_dummies_t *dummies,
+                                              double factor,
+                                              c16_t **rxdata,
+                                              c16_t rxdataF[][frame_parms->nb_antennas_rx][frame_parms->ofdm_symbol_size],
+                                              known_pci_result_t *res)
+{
+  *res = (known_pci_result_t){.pos = pss_pos};
+  if (pss_pos < frame_parms->nb_prefix_samples)
+    return false;
+  known_pci_ssb_fft(frame_parms, rxdata, pss_pos, rxdataF);
+  const uint8_t sss_symbol = SSS_SYMBOL_NB - PSS_SYMBOL_NB;
+  return known_pci_cfar_pass(frame_parms, rxdataF[sss_symbol], known_pci, dummies, factor, res);
+}
