+/* CFAR threshold for the next check: keep a valid cell, or add a new cell */
+static double known_pci_threshold(const neighboring_cell_info_t *neighboring_cell_info)
+{
+  return neighboring_cell_info->valid_meas ? NR_KNOWN_PCI_KEEP_FACTOR : NR_KNOWN_PCI_ADD_FACTOR;
+}
+
+/* Hysteresis (see the comment at the top). Returns true if the cell counts as detected in this check.
+ * passed: the CFAR test passed with the threshold of known_pci_threshold(); tested: a CFAR test ran. */
+static bool known_pci_hysteresis(neighboring_cell_info_t *neighboring_cell_info, bool passed, bool tested)
+{
+  if (neighboring_cell_info->valid_meas)
+    return passed;
+  if (passed)
+    return ++neighboring_cell_info->add_passes >= NR_KNOWN_PCI_ADD_CHECKS;
+  if (tested) // a check without any tested timing (no SSB found in this slot) does not break the series
+    neighboring_cell_info->add_passes = 0;
+  return false;
+}
+
+/* One check of a known PCI: threshold and the results of both paths */
+typedef struct {
+  double factor; // CFAR threshold of this check (known_pci_threshold())
+  known_pci_result_t at_serving; // check at the serving SSB timing
+  known_pci_result_t by_search; // fallback PSS/SSS search; pos -1: not run or no timing found
+} known_pci_check_t;
+
+/* Result of the path that decided the check: the search if it tested a timing, else the serving timing */
+static const known_pci_result_t *known_pci_chosen(const known_pci_check_t *check)
+{
+  return check->by_search.pos >= 0 ? &check->by_search : &check->at_serving;
+}
