+/* e2e-ts patch (oai-ue-neigh-known-pci.patch): measure a KNOWN neighbour PCI at the serving SSB timing first.
+ * In a synchronous TDD network, a neighbour with the same SSB position sends its SSB at the same time as the
+ * serving cell (hub lab: both DUs take frame and slot from the same sample time, nr-ru.c rx_rf()). Then the
+ * neighbour SSB lies on top of the stronger serving SSB. A PSS search then finds the serving cell or a side
+ * lobe, and the SSS check passes at wrong timings that overlap part of the SSB (lab, 20 Nov 2026).
+ * The per-cell RSRP (nr_ue_calculate_ssb_rsrp_cell()) separates the cells at the same timing.
+ * Detection test (CFAR, constant false-alarm rate):
+ *   1. Remove the serving cell's SSS from a copy of the SSS symbol (interference cancellation).
+ *      Without this step, the product of the serving SSS and the neighbour SSS gives every other PCI a
+ *      leftover that grows with the square root of the neighbour power (lab, 20 Nov 2026: max dummy rho 0.055
+ *      at 10 dB, 0.11 at 0 dB, 0.014 with the neighbour absent), and the test fails from ~6 dB.
+ *   2. rho(pci) = cell RSRP of pci on that copy / mean power of all SSS REs before step 1.
+ *   3. ratio = rho(known PCI) / max rho(dummy). The dummies are NR_KNOWN_PCI_CFAR_DUMMIES unused PCIs with
+ *      the same N_ID2, at the same timing. A fixed floor does not work: a neighbour 10 dB below the serving
+ *      cell gives rho ~0.09 (20 dB: ~0.01), but the leftover of an absent PCI depends on the PCI pair.
+ *   4. Hysteresis: a new cell needs ratio > NR_KNOWN_PCI_ADD_FACTOR on NR_KNOWN_PCI_ADD_CHECKS checks in a row;
+ *      a valid cell stays while ratio > NR_KNOWN_PCI_KEEP_FACTOR. A valid cell is LOST after
+ *      NEIGHBOR_CELL_MAX_CONSECUTIVE_FAILURES failed checks in a row (the UE then sends INT_MAX to RRC).
+ *   Offline model (static channel, serving SNR 35 dB, 6 dummies): 0 false adds in 600000 checks with the PCI
+ *   absent; ratio ~22 at 10 dB and ~13 at 25 dB below the serving cell; worst of 100 PCI pairs 6.9 at 25 dB.
+ * If the check at the serving timing fails (other SSB position, cells not synchronous, FDD), the PSS/SSS search
+ * of validate_known_pci() runs as before. Its result must pass the same CFAR test. */
+#define NR_KNOWN_PCI_CFAR_DUMMIES 6
+#define NR_KNOWN_PCI_ADD_FACTOR 3.0
+#define NR_KNOWN_PCI_ADD_CHECKS 2
+#define NR_KNOWN_PCI_KEEP_FACTOR 2.0
+#define NR_SERVING_CANCEL_HALF_WIN 7 /* channel estimate of the serving cell: mean over 2 x 7 + 1 subcarriers */
+
+typedef struct {
+  int nb;
+  uint16_t pci[NR_KNOWN_PCI_CFAR_DUMMIES];
+} known_pci_dummies_t;
+
+/* Result of one known-PCI check, for logs */
+typedef struct {
+  int pos; // start of the PSS (without CP) in the slot buffer; -1: no timing tested
+  double rho; // rho of the known PCI at pos
+  double rho_dummy_max; // largest rho of the dummies at pos
+  double ratio; // rho / rho_dummy_max
+} known_pci_result_t;
+
+/* Start of the serving cell's PSS (without CP) in the slot buffer of proc.
+ * Returns -1 if this slot carries no serving SSB (same periodicity rule as get_ssb_index_in_symbol()). */
+static int serving_ssb_pss_pos(const PHY_VARS_NR_UE *ue, const UE_nr_rxtx_proc_t *proc)
+{
+  const NR_DL_FRAME_PARMS *fp = &ue->frame_parms;
+  const int ssb_period = ue->received_config_request ? ue->nrUE_config.ssb_table.ssb_period : 2;
+  if (ssb_period != 0 && (proc->frame_rx % (1 << (ssb_period - 1))))
+    return -1;
+
+  const int start = nr_get_ssb_start_symbol(fp, fp->ssb_index); // PSS symbol, counted from the half-frame start
+  const int ssb_slot = start / NR_SYMBOLS_PER_SLOT;
+  if (proc->nr_slot_rx != ssb_slot && !(ssb_period == 0 && proc->nr_slot_rx == ssb_slot + fp->slots_per_frame / 2))
+    return -1;
+
+  // CP rule of nr_slot_fep(): the first symbol of each half subframe has the long CP
+  const int pss_symbol = start % NR_SYMBOLS_PER_SLOT;
+  int pos = 0;
+  for (int l = 0; l <= pss_symbol; l++) {
+    const int abs_symbol = proc->nr_slot_rx * NR_SYMBOLS_PER_SLOT + l;
+    pos += (abs_symbol % (0x7 << fp->numerology_index)) ? fp->nb_prefix_samples : fp->nb_prefix_samples0;
+    if (l < pss_symbol)
+      pos += fp->ofdm_symbol_size;
+  }
+  return pos;
+}
+
+/* Unused PCIs with the same N_ID2 as known_pci: not the serving PCI, not a PCI in the neighbour list */
+static known_pci_dummies_t get_known_pci_dummies(const PHY_VARS_NR_UE *ue, uint16_t known_pci)
+{
+  known_pci_dummies_t d = {.nb = 0};
+  const fapi_nr_neighboring_cell_t *cells = ue->nrUE_config.meas_config.nr_neighboring_cell;
+  for (int pci = known_pci % NUMBER_PSS_SEQUENCE; pci <= 1007 && d.nb < NR_KNOWN_PCI_CFAR_DUMMIES; pci += NUMBER_PSS_SEQUENCE) {
+    bool used = pci == known_pci || pci == ue->frame_parms.Nid_cell;
+    for (int i = 0; i < NUMBER_OF_NEIGHBORING_CELLS_MAX && !used; i++)
+      used = cells[i].active && cells[i].Nid_cell == pci;
+    if (!used)
+      d.pci[d.nb++] = pci;
+  }
+  return d;
+}
+
+static inline int16_t sat_int16(double x)
+{
+  return x > INT16_MAX ? INT16_MAX : (x < INT16_MIN ? INT16_MIN : (int16_t)lround(x));
+}
+
+/* Copy of the SSS symbol rxF_sss without the SSS of serving_pci (interference cancellation), into out.
+ * Per antenna, on the 127 SSS subcarriers:
+ *   z[n] = rx[n] d[n] (d = SSS sequence of the serving PCI)
+ *   a = arg(sum z[n] conj(z[n-1])): phase step per subcarrier (timing ramp)
+ *   h[n] = mean of z[k] exp(-j a k) for |k - n| <= NR_SERVING_CANCEL_HALF_WIN (channel of the serving cell)
+ *   out[n] = rx[n] - h[n] exp(j a n) d[n]
+ * The mean over 15 subcarriers follows a frequency-selective channel and averages the neighbour out. */
+static void known_pci_cancel_serving(const NR_DL_FRAME_PARMS *fp,
+                                     const c16_t rxF_sss[][fp->ofdm_symbol_size],
+                                     int serving_pci,
+                                     c16_t out[][fp->ofdm_symbol_size])
+{
+  int16_t d[LENGTH_SSS_NR];
+  nr_sss_sequence(serving_pci, d);
+  const int k0 = fp->ssb_start_subcarrier + 56; // SSS: subcarriers 56..182 of the SSB
+  for (int aarx = 0; aarx < fp->nb_antennas_rx; aarx++) {
+    memcpy(out[aarx], rxF_sss[aarx], sizeof(c16_t) * fp->ofdm_symbol_size);
+    const c16_t *r = rxF_sss[aarx] + k0;
+    double ur[LENGTH_SSS_NR], ui[LENGTH_SSS_NR];
+    double cr = 0, ci = 0;
+    for (int n = 0; n < LENGTH_SSS_NR; n++) {
+      ur[n] = (double)r[n].r * d[n];
+      ui[n] = (double)r[n].i * d[n];
+      if (n > 0) { // z[n] * conj(z[n-1])
+        cr += ur[n] * ur[n - 1] + ui[n] * ui[n - 1];
+        ci += ui[n] * ur[n - 1] - ur[n] * ui[n - 1];
+      }
+    }
+    const double a = atan2(ci, cr);
+    for (int n = 0; n < LENGTH_SSS_NR; n++) { // remove the ramp: u[n] = z[n] exp(-j a n)
+      const double c = cos(a * n), s = sin(a * n);
+      const double xr = ur[n] * c + ui[n] * s, xi = ui[n] * c - ur[n] * s;
+      ur[n] = xr;
+      ui[n] = xi;
+    }
+    for (int n = 0; n < LENGTH_SSS_NR; n++) {
+      const int lo = max(0, n - NR_SERVING_CANCEL_HALF_WIN), hi = min(LENGTH_SSS_NR - 1, n + NR_SERVING_CANCEL_HALF_WIN);
+      double hr = 0, hi_ = 0;
+      for (int k = lo; k <= hi; k++) {
+        hr += ur[k];
+        hi_ += ui[k];
+      }
+      hr /= hi - lo + 1;
+      hi_ /= hi - lo + 1;
+      const double c = cos(a * n), s = sin(a * n);
+      const double er = (hr * c - hi_ * s) * d[n], ei = (hi_ * c + hr * s) * d[n]; // h[n] exp(j a n) d[n]
+      out[aarx][k0 + n].r = sat_int16(r[n].r - er);
+      out[aarx][k0 + n].i = sat_int16(r[n].i - ei);
+    }
+  }
+}
+
+/* CFAR test of known_pci on the SSS symbol rxF_sss: ratio > factor (see the comment at the top).
+ * Writes rho, rho_dummy_max and ratio to res. */
+static bool known_pci_cfar_pass(const NR_DL_FRAME_PARMS *fp,
+                                const c16_t rxF_sss[][fp->ofdm_symbol_size],
+                                uint16_t known_pci,
+                                const known_pci_dummies_t *dummies,
+                                double factor,
+                                known_pci_result_t *res)
+{
+  __attribute__((aligned(32))) c16_t clean[fp->nb_antennas_rx][fp->ofdm_symbol_size];
+  known_pci_cancel_serving(fp, rxF_sss, fp->Nid_cell, clean);
+  const uint32_t all = nr_ue_calculate_ssb_rsrp(fp, rxF_sss, fp->ssb_start_subcarrier);
+  const double norm = all > 0 ? all : 1;
+  res->rho = nr_ue_calculate_ssb_rsrp_cell(fp, clean, fp->ssb_start_subcarrier, known_pci) / norm;
+  res->rho_dummy_max = 0;
+  for (int i = 0; i < dummies->nb; i++) {
+    const double rho = nr_ue_calculate_ssb_rsrp_cell(fp, clean, fp->ssb_start_subcarrier, dummies->pci[i]) / norm;
+    if (rho > res->rho_dummy_max)
+      res->rho_dummy_max = rho;
+  }
+  res->ratio = res->rho_dummy_max > 0 ? res->rho / res->rho_dummy_max : 0;
+  return dummies->nb > 0 && res->ratio > factor;
+}
+
+/* FFT of the PSS and SSS symbols of the SSB whose PSS (without CP) starts at sample pss_pos, into rxdataF */
+static void known_pci_ssb_fft(const NR_DL_FRAME_PARMS *frame_parms,
+                              c16_t **rxdata,
+                              int pss_pos,
+                              c16_t rxdataF[][frame_parms->nb_antennas_rx][frame_parms->ofdm_symbol_size])
+{
+  __attribute__((aligned(32))) c16_t rxdataF_tmp[frame_parms->nb_antennas_rx][frame_parms->samples_per_slot_wCP];
+  const uint8_t sss_symbol = SSS_SYMBOL_NB - PSS_SYMBOL_NB;
+  const int ssb_time_offset = pss_pos - frame_parms->nb_prefix_samples;
+  nr_slot_fep(NULL, frame_parms, 0, 0, 0, rxdataF_tmp, link_type_dl, ssb_time_offset, rxdata);
+  nr_slot_fep(NULL, frame_parms, 0, 0, sss_symbol, rxdataF_tmp, link_type_dl, ssb_time_offset, rxdata);
+  /* TODO: Once symbol based PDSCH proc is implemented, nr_slot_fep() will use
+  the new rxdataF buffer format so the following memcpy can be removed. */
+  for (int aarx = 0; aarx < frame_parms->nb_antennas_rx; aarx++) {
+    memcpy(rxdataF[0][aarx], &rxdataF_tmp[aarx][0], sizeof(c16_t) * frame_parms->ofdm_symbol_size);
+    memcpy(rxdataF[sss_symbol][aarx],
+           &rxdataF_tmp[aarx][sss_symbol * frame_parms->ofdm_symbol_size],
+           sizeof(c16_t) * frame_parms->ofdm_symbol_size);
+  }
+}
